APP_ACCESS_TOKEN=<random-private-token>
CHATGPT_HOST_ID=<stable-UUID>
# Reuse the issued client ID for this ChatGPT account/workspace after first sign-in.
CHATGPT_CLIENT_ID=
MCP_V8_BINARY=/absolute/path/to/mcp-v8
CLOUD_RIVET_ENDPOINT=https://durablejs-wwiv-durablejs-wwiv-d-8xoj:<namespace-secret-token>@api.rivet.dev
# CLIENT_RIVET_ENDPOINT=<cloud endpoint above; omit for local>
# GitHub App installed on all r33drichards repositories:
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Set to the container's public HTTP port when deploying the webhook receiver.
GITHUB_WEBHOOK_PORT=8080
HILLCLIMB_USER_ID=owner
